{
    "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
    "palette": {
        "os": "#a5adce",
        "text": "#c6d0f5",
        "pink": "#f4b8e4",
        "lavender": "#babbf1",
        "blue": "#8caaee",
        "overlay0": "#737994"
    },
    "blocks": [
        {
            "alignment": "left",
            "segments": [
                {
                    "foreground": "p:os",
                    "style": "plain",
                    "template": "{{.Icon}} ",
                    "type": "os"
                },
                {
                    "foreground": "p:blue",
                    "style": "plain",
                    "template": "{{ .UserName }}@{{ .HostName }} ",
                    "type": "session"
                },
                {
                    "foreground": "p:pink",
                    "options": {
                        "folder_icon": "..\ue5fe..",
                        "home_icon": "~",
                        "style": "agnoster_short"
                    },
                    "style": "plain",
                    "template": "{{ .Path }} ",
                    "type": "path"
                },
                {
                    "foreground": "p:lavender",
                    "options": {
                        "branch_icon": "\ue725 ",
                        "cherry_pick_icon": "\ue29b ",
                        "commit_icon": "\uf417 ",
                        "merge_icon": "\ue727 ",
                        "no_commits_icon": "\uf0c3 ",
                        "rebase_icon": "\ue728 ",
                        "revert_icon": "\uf0e2 ",
                        "tag_icon": "\uf412 "
                    },
                    "style": "plain",
                    "template": "{{ .HEAD }} ",
                    "type": "git"
                }
            ],
            "type": "prompt"
        },
        {
            "alignment": "left",
            "newline": true,
            "segments": [
                {
                    "type": "text",
                    "style": "plain",
                    "always_enabled": true,
                    "valid_line": true,
                    "foreground_templates": [
                        "{{ if gt .Code 0 }}p:pink{{ else }}p:blue{{ end }}"
                    ],
                    "template": "\uf111"
                },
                {
                    "type": "text",
                    "style": "plain",
                    "foreground": "p:text",
                    "template": " >"
                }
            ],
            "type": "prompt"
        }
    ],
    "final_space": true,
    "version": 4
}


